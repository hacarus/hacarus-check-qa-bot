# ===== 認証 =====
# subscription: 自分の Claude の使用枠で動かす(動作確認用。利用者は自分1人に限られる)
# api         : 会社の API キーで従量課金で動かす(公開用)
AUTH_MODE=subscription

# subscription のとき: `claude setup-token` で発行したトークン。
# 手元で Claude Code にログイン済みなら空欄でもよい
CLAUDE_CODE_OAUTH_TOKEN=

# api のとき: Console で発行した API キー(subscription のときは空欄にする)
ANTHROPIC_API_KEY=

# ===== 質問対象 =====
# hacarus-check-2025 をクローンした場所。開発用の作業コピーとは別のクローンを推奨
REPO_PATH=../hacarus-check-2025-mirror
# 参照を禁止するパス(リポジトリからの相対パス、カンマ区切り)
DENY_PATHS=.git/**

# ===== モデルと上限 =====
MODEL=claude-sonnet-5-5
# low / medium / high / xhigh / max(空欄ならモデルの既定)
EFFORT=
# 1つの質問で許す往復回数と料金の上限(USD)
MAX_TURNS=30
MAX_BUDGET_USD=2.0
# 同時に処理する質問の数
MAX_CONCURRENCY=2

# ===== Slack(情シスにアプリを作ってもらってから設定する) =====
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# 質問できる Slack ユーザー ID(カンマ区切り、* で全員)。
# subscription のときは自分の ID を1つだけ指定できる
ALLOWED_SLACK_USERS=
# /qa-cost で集計を見られる Slack ユーザー ID
ADMIN_SLACK_USERS=
# 回答の末尾に往復回数と仮想料金を表示する
SHOW_COST_FOOTER=true

# ===== 記録 =====
DB_PATH=data/qa_bot.sqlite3
# 質問文も記録する(false にするとトークン数と料金だけを記録する)
LOG_QUESTION_TEXT=true
