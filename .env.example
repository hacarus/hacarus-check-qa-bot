# ===== 認証 =====
# subscription: 自分の Claude の使用枠で動かす(検証用。利用者は自分1人に限られる)
# api         : 会社の API キーで従量課金で動かす(公開用)
AUTH_MODE=subscription

# subscription のとき: `claude setup-token` で発行したトークン。
# 手元で Claude Code にログイン済みなら空欄でもよい
CLAUDE_CODE_OAUTH_TOKEN=

# api のとき: Console で発行した API キー(subscription のときは空欄にする)
ANTHROPIC_API_KEY=

# ===== 質問対象 =====
# scripts\sync_repo.ps1 で作るミラー(作業ツリーのない Git リポジトリ)
MIRROR_PATH=data/mirror.git
# 参照を禁止するパス(リポジトリからの相対パス、カンマ区切り)
DENY_PATHS=.git/**
# git.exe が PATH にない場合はフルパスを書く
GIT_PATH=git

# ===== モデルと上限 =====
MODEL=claude-sonnet-5-5
# low / medium / high / xhigh / max(空欄ならモデルの既定)
EFFORT=
# 1つの質問で許す往復回数と料金の上限(USD)
MAX_TURNS=30
MAX_BUDGET_USD=2.0
# 同時に処理する質問の数
MAX_CONCURRENCY=2
# 1人が1日に質問できる件数(0 で無制限)。日付の区切りは TIMEZONE で決める
DAILY_LIMIT_PER_USER=20
TIMEZONE=Asia/Tokyo

# ===== Slack =====
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# 質問できる Slack ユーザー ID(カンマ区切り、* で全員)。
# ユーザーグループも書ける。S で始まるグループ ID か @ハンドル名(例: @sales)。メンバーは10分ごとに読み直す
# subscription のときは自分の ID を1つだけ指定できる(グループは書けない)
ALLOWED_SLACK_USERS=
# /qa-cost で集計を見られる Slack ユーザー ID(ユーザーグループも書ける)
ADMIN_SLACK_USERS=
# 回答の下に往復回数と仮想料金を表示する場所(always: どこでも / dm: DM と AI アプリのパネルだけ / never: 表示しない)
COST_FOOTER=dm
# メンションで答えるチャンネルの ID(カンマ区切り)。空欄ならボットを招待したすべてのチャンネルで答える
# 社外と共有したチャンネル(Slack コネクト)では、この設定に関係なく答えない
ALLOWED_CHANNELS=
# メンションされたときに文脈として読む、直前の発言の最大数(0 で読まない)
THREAD_CONTEXT_MESSAGES=20

# ===== 記録 =====
DATA_DIR=data
# 質問文と回答文も記録する(false にするとトークン数・料金・評価だけを記録する)
LOG_QUESTION_TEXT=true
# 質問・回答・評価の保存日数と、会話の続きに使うセッション記録の保存日数
RETENTION_DAYS=365
SESSION_RETENTION_DAYS=30

# ===== Claude Code =====
# ボットが使う Claude Code(claude.exe)のパス。空欄なら SDK に同梱の版、なければ PATH 上の claude を使う。
# Windows 向けの SDK は同梱の版が新しいモデルに追いつかないことがあるので、task check で版を確かめる
CLAUDE_CLI_PATH=
